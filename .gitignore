# 环境变量（含密钥），只入库 .env.example
.env
.env.*

# find-skill 本机密钥（SkillsMP key）与本机 catalogue / 日志数据
pi/agent/skills/find-skill/.env
pi/agent/skills/find-skill/cache/

# backup skill 本机端点注册表与凭证（endpoints.json / *.token 等），仅 endpoints/README.md 入库
pi/agent/skills/backup/endpoints/*
!pi/agent/skills/backup/endpoints/README.md

# Claude Code 本机本地配置（permissions + autoMemoryDirectory 绝对路径），仅本机、不入库；
# clone 者复制 .claude/settings.local.example.json → settings.local.json 后按本机路径填
.claude/settings.local.json

# AutoMemory 变更标记 / 检查点（运行时产物）
.memory-changed-this-session
.last-memory-checkpoint

# 临时产物目录（预览图、调试快照等），不入库
tmp/

# 运行时数据目录，不入库（只限定根目录；不能写成裸 `docs/`——那会把镜像部分
# 镜像 docs（`pi/agent/docs/`）一起吞掉：本地 diff 全绿、远端却少一整部分，2026-10-04 事故）
/docs/

# Python 字节码缓存（本地生成，不入库）
__pycache__/

# Node 依赖
node_modules/

# macOS 系统文件
.DS_Store

# session-link 运行时状态（本机专属，不进镜像）
pi/agent/patch/session-link/config.json
pi/agent/patch/session-link/local-links.json
pi/agent/patch/session-link/chain-registry.json
