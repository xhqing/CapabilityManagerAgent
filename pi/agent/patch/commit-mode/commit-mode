#!/usr/bin/env python3
"""commit-mode —— 按项目分别切换「自动 add / 自动 commit」两个开关。

背景（2026-10-31 用户立）：全局规则里有一条常设授权「工作区 / 暂存区有待提交内容
就直接按 add skill / commit skill 提交，不用问」。这条很方便，但有时用户想先看看
工作区相对暂存区的改动（例如用 diff 视图逐行过一遍），此时需要暂停自动提交。
2026-10-31 用户进一步要求：**add 和 commit 分开控制**——
  - 关掉自动 add：AI 不把改动放进暂存区，工作区保持原样（`git diff` 看工作区 vs 暂存区）；
  - 关掉自动 commit：AI 不提交，但可以照常 add（`git diff --cached` 看暂存区 vs HEAD）。

用法：
  commit-mode status [路径]              查看 add / commit 两个开关的当前状态
  commit-mode manual add    [路径]       暂停自动 add
  commit-mode manual commit [路径]       暂停自动 commit
  commit-mode manual all    [路径]       两个都暂停（省略对象时默认 all）
  commit-mode auto   add|commit|all [路径]   恢复自动
  commit-mode toggle add|commit|all [路径]   在两种状态之间切换
  commit-mode list                      列出被暂停的项目
  commit-mode off / on [对象] [路径]     别名（off = manual，on = auto）

路径省略时默认取当前目录所在 git 仓库的根目录（不在仓库内则取当前目录）。登记的是
目录路径：该目录本身以及它下面所有子目录（含子项目仓库）都生效。

状态文件：~/.pi/agent/state/commit-mode.json
  {
    "manualAdd":    ["<目录路径>", ...],   # 自动 add 已关闭的项目
    "manualCommit": ["<目录路径>", ...],   # 自动 commit 已关闭的项目
    "updated": "<ISO 时间>"
  }
  （state/ 目录在 macmini 镜像里被排除，所以两机各管各的，互不干扰。）

谁在读这个状态：
  - ~/.pi/agent/extensions/commit-mode-guard.ts：系统提示注入 + 硬拦截 git add / git commit
  - ~/.pi/agent/extensions/redundant-ask-guard.ts：授权清单按两个开关改写
  - ~/.pi/agent/extensions/settle-repo-check.ts：收尾巡检跳过被暂停的仓库
"""

import json
import os
import subprocess
import sys
from datetime import datetime

STATE = os.path.expanduser("~/.pi/agent/state/commit-mode.json")
KEY_ADD = "manualAdd"
KEY_COMMIT = "manualCommit"
OBJECTS = ("add", "commit", "all")


def norm(path):
    """规范化为绝对路径（解析软链，如 macOS 的 /tmp → /private/tmp）、去掉尾随斜杠。"""
    return os.path.realpath(os.path.expanduser(path)).rstrip("/") or "/"


def under(path, root):
    """path 是否等于 root 或位于 root 之下。"""
    return path == root or path.startswith(root + "/")


def repo_root(path):
    """取路径所在 git 仓库的根目录；不在仓库内（或 git 不可用）返回路径本身。"""
    try:
        out = subprocess.run(
            ["git", "-C", path, "rev-parse", "--show-toplevel"],
            capture_output=True,
            text=True,
            timeout=10,
        )
        if out.returncode == 0 and out.stdout.strip():
            return norm(out.stdout.strip())
    except (OSError, subprocess.SubprocessError):
        pass
    return norm(path)


def clean(items):
    """规范化 + 去重 + 去掉被父条目覆盖的多余子条目。"""
    out = []
    for item in items or []:
        if isinstance(item, str) and item.strip():
            out.append(norm(item))
    result = []
    for item in sorted(set(out), key=len):
        if not any(under(item, kept) for kept in result):
            result.append(item)
    return result


def load_all():
    """读两个开关的条目；兼容旧版单一 manual 字段（迁移为两个都手动）。"""
    try:
        with open(STATE, encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, ValueError):
        data = {}
    legacy = clean(data.get("manual"))
    add = clean(data.get(KEY_ADD, legacy))
    commit = clean(data.get(KEY_COMMIT, legacy))
    return add, commit


def save(add, commit):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    payload = {
        KEY_ADD: sorted(set(add)),
        KEY_COMMIT: sorted(set(commit)),
        "updated": datetime.now().astimezone().isoformat(timespec="seconds"),
    }
    tmp = STATE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(payload, f, ensure_ascii=False, indent=2)
        f.write("\n")
    os.replace(tmp, STATE)


def split_args(argv):
    """解析「可选对象 + 可选路径」：对象只能是 add / commit / all，其余都当路径。"""
    obj = "all"
    rest = list(argv)
    if rest and rest[0] in OBJECTS:
        obj = rest[0]
        rest = rest[1:]
    elif len(rest) >= 2 and rest[1] in OBJECTS:
        # 兼容「manual /path add」这种路径在前的写法
        obj = rest[1]
        rest = [rest[0]] + rest[2:]
    return obj, rest


def target_path(argv):
    """命令行给的路径，或默认取当前仓库根。"""
    if argv:
        return norm(argv[0])
    return repo_root(os.getcwd())


def covering_entry(path, entries):
    """返回覆盖 path 的条目（没有则 None）。"""
    for entry in entries:
        if under(path, entry):
            return entry
    return None


def mode_of(path, entries):
    """返回 (是否手动, 覆盖条目或 None)。同时看路径与它所在仓库根。"""
    root = repo_root(path)
    entry = covering_entry(path, entries) or covering_entry(root, entries)
    return (entry is not None), entry


def mode_label(kind, manual, entry):
    name = "add" if kind == "add" else "commit"
    if manual:
        return f"{name}：手动（自动 {name} 已关闭，由条目 {entry} 覆盖）"
    return f"{name}：自动"


def explain(add_manual, commit_manual):
    if add_manual and commit_manual:
        return (
            "含义：AI 不会自行发起 add 或 commit，改动留在工作区；\n"
            "      用户当轮明确要求提交时才执行（照常走 skill 全流程）。"
        )
    if add_manual and not commit_manual:
        return (
            "含义：AI 不会自行把改动放进暂存区（add 暂停，工作区保持原样，便于 git diff）；\n"
            "      commit 本身是自动的，但没有新暂存内容时不会产生提交。"
        )
    if commit_manual and not add_manual:
        return (
            "含义：AI 会按 /add 把干净改动放进暂存区（便于 git diff --cached）；\n"
            "      但不会自行 commit，预检干净后也不自动衔接 commit。"
        )
    return "含义：工作区 / 暂存区有待提交内容时，AI 会直接按 /add → /commit 流程处理。"


def cmd_status(argv):
    path = target_path(argv)
    add, commit = load_all()
    add_manual, add_entry = mode_of(path, add)
    commit_manual, commit_entry = mode_of(path, commit)
    print(f"当前目录：{norm(os.getcwd())}")
    print(f"检查路径：{path}")
    print(f"仓库根：{repo_root(path)}")
    print(mode_label("add", add_manual, add_entry))
    print(mode_label("commit", commit_manual, commit_entry))
    print(explain(add_manual, commit_manual))
    return 0


def cmd_manual(argv):
    obj, rest = split_args(argv)
    target = target_path(rest)
    add, commit = load_all()
    changed = []
    if obj in ("add", "all") and covering_entry(target, add) is None:
        add.append(target)
        changed.append("add")
    if obj in ("commit", "all") and covering_entry(target, commit) is None:
        commit.append(target)
        changed.append("commit")
    if changed:
        save(add, commit)
        names = "、".join("自动 " + c for c in changed)
        print(f"已暂停：{names}　目标：{target}")
        print("该目录及其子目录里的仓库都生效；用户当轮明确要求时才执行被暂停的步骤。")
    else:
        names = {"add": "自动 add", "commit": "自动 commit", "all": "自动 add / commit"}[obj]
        print(f"本来就是手动状态（{names}）：{target}")
    print("查看状态：commit-mode status　恢复：commit-mode auto <add|commit|all>")
    return 0


def cmd_auto(argv):
    obj, rest = split_args(argv)
    target = target_path(rest)
    add, commit = load_all()
    changed = []
    notes = []

    def remove(entries, kind):
        kept, parent = [], None
        for entry in entries:
            if under(entry, target):
                continue  # 该条目本身在目标之下：移除
            kept.append(entry)
        for entry in entries:
            if entry != target and under(target, entry):
                parent = entry
                break
        if kept != entries:
            changed.append(kind)
        if parent:
            notes.append(f"上层条目 {parent} 仍覆盖这里，{kind} 实际仍是手动；先对它执行 auto。")
        return kept

    if obj in ("add", "all"):
        add = remove(add, "add")
    if obj in ("commit", "all"):
        commit = remove(commit, "commit")
    if changed:
        save(add, commit)
        names = "、".join("自动 " + c for c in changed)
        print(f"已恢复：{names}　目标：{target}")
    else:
        names = {"add": "自动 add", "commit": "自动 commit", "all": "自动 add / commit"}[obj]
        print(f"当前本来就是自动状态（{names}）：{target}")
    for note in notes:
        print(f"注意：{note}")
    return 0


def cmd_toggle(argv):
    obj, rest = split_args(argv)
    target = target_path(rest)
    add, commit = load_all()
    add_manual, _ = mode_of(target, add)
    commit_manual, _ = mode_of(target, commit)
    want_manual = not (add_manual or commit_manual)
    return (cmd_manual if want_manual else cmd_auto)(([obj] if obj != "all" else []) + [target])


def cmd_list(argv):
    add, commit = load_all()
    if not add and not commit:
        print("当前没有任何被暂停的项目（add / commit 都是自动）。")
        return 0
    if add:
        print(f"自动 add 已关闭（手动）的项目（{len(add)} 个）：")
        for entry in add:
            mark = "" if os.path.isdir(entry) else "  [目录不存在]"
            print(f"  - {entry}{mark}")
    else:
        print("自动 add 已关闭的项目：无")
    if commit:
        print(f"自动 commit 已关闭（手动）的项目（{len(commit)} 个）：")
        for entry in commit:
            mark = "" if os.path.isdir(entry) else "  [目录不存在]"
            print(f"  - {entry}{mark}")
    else:
        print("自动 commit 已关闭的项目：无")
    return 0


COMMANDS = {
    "status": cmd_status,
    "manual": cmd_manual,
    "off": cmd_manual,
    "auto": cmd_auto,
    "on": cmd_auto,
    "toggle": cmd_toggle,
    "list": cmd_list,
}

HELP = __doc__.split("用法：")[1] if "用法：" in __doc__ else ""


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print("commit-mode —— 按项目分别切换「自动 add / 自动 commit」两个开关\n")
        print("用法：" + HELP.strip())
        return 0
    cmd = argv[0]
    if cmd not in COMMANDS:
        print(f"未知命令：{cmd}\n", file=sys.stderr)
        print("用法：" + HELP.strip(), file=sys.stderr)
        return 2
    return COMMANDS[cmd](argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
