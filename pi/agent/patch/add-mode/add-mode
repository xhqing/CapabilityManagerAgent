#!/usr/bin/env python3
"""add-mode —— 按项目开关「自动 add」。

背景（2026-10-31 用户立）：全局规则里有一条常设授权「工作区有待提交内容就直接按 add
skill 预检并加入暂存区，不用问」。但用户有时想先看看**工作区相对暂存区**的改动
（`git diff`），这时需要暂停自动 add：本命令把某个项目登记为「手动 add」，AI 就不再
主动走 /add、不执行 git add，改动原样留在工作区。

**与 commit-mode 完全独立**：两个命令、两个状态文件、两个守卫扩展，互不读对方的代码。
本命令只管 add；想同时管住 commit 请用另一个命令 `commit-mode`。

用法：
  add-mode status [路径]   查看当前（或指定路径）的自动 add 状态
  add-mode manual [路径]   暂停自动 add
  add-mode auto   [路径]   恢复自动 add
  add-mode toggle [路径]   在两种状态之间切换
  add-mode list            列出自动 add 已关闭的项目
  add-mode off / on        别名（off = manual，on = auto）

路径省略时默认取当前目录所在 git 仓库的根目录（不在仓库内则取当前目录）。登记的是
目录路径：该目录本身以及它下面所有子目录（含子项目仓库）都生效。

状态文件：~/.pi/agent/state/add-mode.json
  { "manual": ["<目录路径>", ...], "updated": "<ISO 时间>" }
  （state/ 目录在 macmini 镜像里被排除，所以两机各管各的，互不干扰。）

谁在读这个状态：
  - ~/.pi/agent/extensions/add-mode-guard.ts：系统提示注入 + 硬拦截 git add
  - ~/.pi/agent/extensions/redundant-ask-guard.ts：授权清单里 add 相关那条按状态改写
  - ~/.pi/agent/extensions/settle-repo-check.ts：收尾巡检跳过被暂停的仓库
"""

import json
import os
import subprocess
import sys
from datetime import datetime

STATE = os.path.expanduser("~/.pi/agent/state/add-mode.json")


def norm(path):
    """规范化为绝对路径（解析软链，如 macOS 的 /tmp → /private/tmp）、去掉尾随斜杠。"""
    return os.path.realpath(os.path.expanduser(path)).rstrip("/") or "/"


def under(path, root):
    """path 是否等于 root 或位于 root 之下。"""
    return path == root or path.startswith(root + "/")


def repo_root(path):
    """取路径所在 git 仓库的根目录；不在仓库内（或 git 不可用）返回路径本身。"""
    try:
        out = subprocess.run(
            ["git", "-C", path, "rev-parse", "--show-toplevel"],
            capture_output=True,
            text=True,
            timeout=10,
        )
        if out.returncode == 0 and out.stdout.strip():
            return norm(out.stdout.strip())
    except (OSError, subprocess.SubprocessError):
        pass
    return norm(path)


def load():
    """读手动 add 的条目；规范化 + 去重 + 去掉被父条目覆盖的多余子条目。"""
    try:
        with open(STATE, encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, ValueError):
        data = {}
    raw = []
    for item in data.get("manual") or []:
        if isinstance(item, str) and item.strip():
            raw.append(norm(item))
    entries = []
    for item in sorted(set(raw), key=len):
        if not any(under(item, kept) for kept in entries):
            entries.append(item)
    return entries


def save(entries):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    payload = {
        "manual": sorted(set(entries)),
        "updated": datetime.now().astimezone().isoformat(timespec="seconds"),
    }
    tmp = STATE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(payload, f, ensure_ascii=False, indent=2)
        f.write("\n")
    os.replace(tmp, STATE)


def target_path(argv):
    """命令行给的路径，或默认取当前仓库根。"""
    if argv:
        return norm(argv[0])
    return repo_root(os.getcwd())


def covering_entry(path, entries):
    """返回覆盖 path 的条目（没有则 None）。"""
    for entry in entries:
        if under(path, entry):
            return entry
    return None


def cmd_status(argv):
    path = target_path(argv)
    root = repo_root(path)
    entry = covering_entry(path, load()) or covering_entry(root, load())
    print(f"当前目录：{norm(os.getcwd())}")
    print(f"检查路径：{path}")
    print(f"仓库根：{root}")
    if entry:
        print(f"自动 add：已关闭（手动，由条目 {entry} 覆盖）")
        print("含义：AI 不主动走 /add、不执行 git add，改动留在工作区（可看 git diff）；")
        print("      用户当轮明确要求 add / 提交时才执行。")
    else:
        print("自动 add：开启")
        print("含义：工作区有干净改动时，AI 会按 add skill 预检后直接加入暂存区。")
    return 0


def cmd_manual(argv):
    target = target_path(argv)
    entries = load()
    entry = covering_entry(target, entries)
    if entry:
        print(f"已经是手动 add：{target}")
        print(f"（已被条目 {entry} 覆盖）")
        return 0
    entries.append(target)
    save(entries)
    print(f"已暂停自动 add：{target}")
    print("该目录及其子目录里的仓库都生效；用户明确要求 add / 提交时才执行。")
    print("恢复：add-mode auto")
    return 0


def cmd_auto(argv):
    target = target_path(argv)
    entries = load()
    parent = None
    for entry in entries:
        if entry != target and under(target, entry):
            parent = entry
            break
    kept = [e for e in entries if not under(e, target)]
    if kept != entries:
        save(kept)
        print(f"已恢复自动 add：{target}")
    else:
        print(f"当前本来就是自动 add：{target}")
    if parent:
        print(f"注意：上层条目 {parent} 仍然覆盖这里，实际仍是手动 add。")
        print(f"      要让这里自动，先对上层条目执行：add-mode auto {parent}")
    return 0


def cmd_toggle(argv):
    target = target_path(argv)
    if covering_entry(target, load()):
        return cmd_auto([target])
    return cmd_manual([target])


def cmd_list(argv):
    entries = load()
    if not entries:
        print("当前没有任何项目暂停自动 add（全部自动）。")
        return 0
    print(f"自动 add 已关闭（手动）的项目（共 {len(entries)} 个）：")
    for entry in entries:
        mark = "" if os.path.isdir(entry) else "  [目录不存在]"
        print(f"  - {entry}{mark}")
    return 0


COMMANDS = {
    "status": cmd_status,
    "manual": cmd_manual,
    "off": cmd_manual,
    "auto": cmd_auto,
    "on": cmd_auto,
    "toggle": cmd_toggle,
    "list": cmd_list,
}

HELP = __doc__.split("用法：")[1] if "用法：" in __doc__ else ""


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print("add-mode —— 按项目开关「自动 add」（与 commit-mode 完全独立）\n")
        print("用法：" + HELP.strip())
        return 0
    cmd = argv[0]
    if cmd not in COMMANDS:
        print(f"未知命令：{cmd}\n", file=sys.stderr)
        print("用法：" + HELP.strip(), file=sys.stderr)
        return 2
    return COMMANDS[cmd](argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
